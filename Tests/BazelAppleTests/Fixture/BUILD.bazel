load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")
load("@rules_swift//swift:swift.bzl", "swift_library")

apple_resource_bundle(
    name = "first_storyboard_resources",
    resources = ["First.storyboard"],
)

apple_resource_bundle(
    name = "second_storyboard_resources",
    resources = ["Second.storyboard"],
)

swift_library(
    name = "private_helper",
    srcs = glob(["Private/*.swift"]),
    module_name = "PrivateHelper",
)

swift_library(
    name = "app_sources",
    srcs = glob(["Sources/*.swift"]),
    private_deps = [":private_helper"],
)

macos_application(
    name = "app",
    bundle_id = "io.goodkind.periphery.fixture",
    infoplists = ["Info.plist"],
    minimum_os_version = "13.0",
    resources = ["Localizable.xcstrings"],
    deps = [":app_sources"],
)

swift_library(
    name = "ios_sources",
    srcs = glob(["IOS/*.swift"]),
    data = [
        ":first_storyboard_resources",
        ":second_storyboard_resources",
    ],
)

ios_application(
    name = "ios_app",
    bundle_id = "io.goodkind.periphery.iosfixture",
    families = ["iphone", "ipad"],
    infoplists = ["Info-iOS.plist"],
    minimum_os_version = "17.0",
    deps = [":ios_sources"],
)
