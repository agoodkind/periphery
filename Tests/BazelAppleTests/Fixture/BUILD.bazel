load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:macos.bzl", "macos_application", "macos_framework", "macos_xpc_service")
load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")
load("@rules_apple//apple:tvos.bzl", "tvos_application")
load("@rules_apple//apple:visionos.bzl", "visionos_application")
load("@rules_apple//apple:watchos.bzl", "watchos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

apple_resource_bundle(
    name = "first_storyboard_resources",
    resources = ["First.storyboard"],
)

apple_resource_bundle(
    name = "second_storyboard_resources",
    resources = ["Second.storyboard"],
)

swift_library(
    name = "private_helper",
    srcs = glob(["Private/*.swift"]),
    module_name = "PrivateHelper",
)

swift_library(
    name = "app_sources",
    srcs = glob(["Sources/*.swift"]),
    private_deps = [":private_helper"],
)

swift_library(
    name = "embedded_framework_sources",
    srcs = glob(["EmbeddedFramework/*.swift"]),
)

macos_framework(
    name = "embedded_framework",
    bundle_id = "io.goodkind.periphery.fixture.framework",
    infoplists = ["Info.plist"],
    minimum_os_version = "13.0",
    deps = [":embedded_framework_sources"],
)

swift_library(
    name = "embedded_service_sources",
    srcs = glob(["EmbeddedService/*.swift"]),
)

macos_xpc_service(
    name = "embedded_service",
    bundle_id = "io.goodkind.periphery.fixture.service",
    infoplists = ["Info.plist"],
    minimum_os_version = "13.0",
    deps = [":embedded_service_sources"],
)

macos_application(
    name = "app",
    bundle_id = "io.goodkind.periphery.fixture",
    frameworks = [":embedded_framework"],
    infoplists = ["Info.plist"],
    minimum_os_version = "13.0",
    resources = ["Localizable.xcstrings"],
    xpc_services = [":embedded_service"],
    deps = [":app_sources"],
)

swift_library(
    name = "ios_sources",
    srcs = glob(["IOS/*.swift"]),
    data = [
        ":first_storyboard_resources",
        ":second_storyboard_resources",
    ],
)

ios_application(
    name = "ios_app",
    bundle_id = "io.goodkind.periphery.iosfixture",
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = ["Info-iOS.plist"],
    minimum_os_version = "17.0",
    deps = [":ios_sources"],
)

swift_library(
    name = "tvos_sources",
    srcs = glob(["TVOS/*.swift"]),
)

tvos_application(
    name = "tvos_app",
    bundle_id = "io.goodkind.periphery.tvfixture",
    infoplists = ["Info-iOS.plist"],
    minimum_os_version = "17.0",
    deps = [":tvos_sources"],
)

swift_library(
    name = "watchos_sources",
    srcs = glob(["WatchOS/*.swift"]),
)

watchos_application(
    name = "watchos_app",
    bundle_id = "io.goodkind.periphery.watchfixture",
    infoplists = ["Info-iOS.plist"],
    minimum_os_version = "10.0",
    deps = [":watchos_sources"],
)

swift_library(
    name = "visionos_sources",
    srcs = glob(["VisionOS/*.swift"]),
)

visionos_application(
    name = "visionos_app",
    bundle_id = "io.goodkind.periphery.visionfixture",
    infoplists = ["Info-iOS.plist"],
    minimum_os_version = "1.0",
    deps = [":visionos_sources"],
)
